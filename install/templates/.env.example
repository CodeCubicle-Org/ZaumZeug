# ZaumZeug environment — copy to `.env` and fill in values you need.
# Never commit `.env` (it is gitignored). Mock profile needs no keys.

# Provider API keys (set only what you use for live models):
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_API_KEY=
# COHERE_API_KEY=
# GEMINI_API_KEY=

# Optional OpenAI-compatible base URL (e.g. LM Studio):
# OPENAI_API_BASE=http://localhost:1234/v1
